# ==============================================================================
# EvacuSafe Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.
# ==============================================================================

# --- Core Django & Security ---
# In production, SECRET_KEY must be a strong, unpredictable random string.
# When DEBUG=True, a dev-only fallback is permitted. In production (DEBUG=False), it is strictly required.
SECRET_KEY=django-insecure-replace-with-a-cryptographically-secure-random-key-in-production

# Set DEBUG=False for production deployments. Defaults to False if omitted.
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of origins trusted for unsafe (POST/PUT) requests (e.g. for CSRF protection).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080

# Production SSL and Cookie Hardening (applies when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Supabase PostgreSQL Database ---
# Supabase Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" or "Transaction pooler" URI (port 6543) for hosted serverless deployments,
# or the direct connection (port 5432) for direct database access.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Require SSL for PostgreSQL connections (recommended for Supabase)
DB_SSL_REQUIRE=True

# Optional: set USE_SQLITE=True to force local SQLite development without Supabase
USE_SQLITE=False
CONN_MAX_AGE=600

# --- Supabase API Keys (Client / Edge integration) ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# --- Email Notifications (Alerts & Emergency Broadcasts) ---
# In development (DEBUG=True), emails output to the console. In production, configure SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-smtp-password
DEFAULT_FROM_EMAIL=EvacuSafe Alerts <alerts@evacusafe.org>

# --- SMS Alerts (Twilio / Gateway Integration) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
